# ─── Required ────────────────────────────────────────────────────────────────

# Pushover credentials (get from pushover.net)
PUSHOVER_APP_KEY=your_app_token_here
PUSHOVER_USER_KEY=your_user_key_here

# Path where Immich stores photos (your UPLOAD_LOCATION)
PHOTOS_PATH=/Volumes/L1/photos

# Root of your SSD mount (used to detect if SSD is unplugged)
SSD_MOUNT=/Volumes/L1

# ─── Optional (defaults shown) ───────────────────────────────────────────────

# Where to store pg_dump backups (defaults to PHOTOS_PATH/db-backup)
# BACKUP_PATH=/Volumes/L1/db-backup

# Docker container names (match your docker-compose service names)
# POSTGRES_CONTAINER=immich_postgres
# IMMICH_CONTAINER=immich_server

# Postgres user
# DB_USER=postgres
# DB_PASS=123456

# Video compression quality (0-51, lower = better quality, larger file)
# 28 is a good balance. Go lower (24-26) for higher quality.
# VIDEO_CRF=28

# ffmpeg speed preset: ultrafast, fast, medium, slow, veryslow
# Slower = better compression, more CPU. medium is fine.
# VIDEO_PRESET=medium
